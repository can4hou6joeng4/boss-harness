{
  "name": "boss-harness",
  "private": true,
  "version": "0.2.0-rc.288",
  "license": "MIT",
  "description": "BOSS Harness：面向招聘任务的 Agent Harness（Python 内核与 Electron 桌面）",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace boss-harness-desktop",
    "build": "npm run build --workspace boss-harness-desktop",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "check": "for check in scripts/check_*.py; do \"${PYTHON:-.venv/bin/python}\" \"$check\" || exit $?; done"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/can4hou6joeng4/boss-harness.git"
  },
  "homepage": "https://github.com/can4hou6joeng4/boss-harness#readme",
  "bugs": {
    "url": "https://github.com/can4hou6joeng4/boss-harness/issues"
  }
}
